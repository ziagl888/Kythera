# Gemeinsamer Channel der Research-Bots 30-33 (PEX1/FMR1/TRM1/FIF1)
CH_NEW_IDEAS=-100XXXXXXXXXX
# FIF2 (bot 43): unset/empty ⇒ fallback to CH_FIF1 (⇒ CH_NEW_IDEAS if that is
# unset too); an explicit 0 forces shadow-only.
CH_FIF2=
# MAX1 (Bot 34): ungesetzt/leer ⇒ Fallback auf CH_MAIN (Operator-Entscheid:
# die High-Conviction-Trades gehören in den Channel, den Michi tradet).
CH_MAX1=

# Trailing-Close-Bot (Bot 40, T-2026-KYT-9050-042 Phase C): EIGENER Channel für den
# Trailing-Arm. Michi hängt Cornix selbst dran. NIE einen bestehenden Handels-Channel
# eintragen — der Bot postet `Close <SYMBOL>`, und das wirkt symbol-weit.
CH_TRAILING=
# Doppeltes Sicherheitsnetz: BEIDES muss gesetzt sein, damit der Bot postet.
# Ungesetzt/0 ⇒ er läuft, trackt und loggt, schreibt aber keine Outbox-Zeile.
TRAILING_BOT_LIVE_POSTING=0
# Wie frisch ein Quell-Signal sein muss, um gespiegelt zu werden. Eng, damit der
# gepostete Entry noch am Markt liegt — sonst öffnet Cornix ihn nie.
TRAILING_BOT_MAX_AGE_SEC=30
# Wartezeit auf den Fill, bevor die Order als verfallen gilt und geräumt wird.
TRAILING_BOT_FILL_TIMEOUT_MIN=10
# Sperrzeit eines Symbols nach einem geposteten Close (Race gegen Cornix).
TRAILING_BOT_SYMBOL_COOLDOWN_SEC=60

# Unrestricted trailing twin (bot 44, T-2026-KYT-9050-117): bot 40's engine with
# no admission caps, ALL roster trades spread evenly over TWO channels
# (Cornix caps 500 per channel -> ~1000 seats). Unset channels fall back to
# CH_SHADOW_TEST (not Cornix-executed). NEVER enter an existing trading
# channel - the bot posts `Close <SYMBOL>`, which acts symbol-wide.
CH_TRAILING_FREE_A=
CH_TRAILING_FREE_B=
# Double safety net like bot 40: BOTH the gate and the channels must be set
# for the bot to post. Unset/0 -> it runs, tracks and logs, but posts nothing.
TRAILING_FREE_LIVE_POSTING=0
