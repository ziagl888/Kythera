# Copy to .env and fill in. .env is gitignored.

# --- required secrets ---
TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Health-Alerts des Watchdogs (Daten-Staleness/CPU/Outbox-Failures):
# private Chat-ID mit dem Bot. Bot einmal /start-en, ID z.B. via @userinfobot.
TELEGRAM_ALERT_CHAT_ID=
DB_NAME=cryptodata
DB_USER=dbfiller
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
BINANCE_API_KEY=
BINANCE_SECRET=

# --- rollout flags ---
# AIM2 (Bot 15): 0 = Shadow-only (Vorhersagen nur in ml_predictions_master),
# 1 = Live-Posting in CH_MASTER. Siehe docs/AIM2_DESIGN.md, Rollout-Gates.
AIM2_LIVE_POSTING=0
# Research-Bots 30-33 (PEX1/FMR1/TRM1/FIF1): 1 = Live-Posting in CH_NEW_IDEAS
# (Operator-Entscheid 2026-07-06: der Channel IST die Testumgebung),
# 0 = Shadow-only. Siehe docs/NEW_IDEAS_BOTS.md.
NEW_IDEAS_LIVE_POSTING=1
# FIF2 (bot 43, vol-gated ladder mirror, T-2026-KYT-9050-112): 1 = live posts
# into CH_FIF2 (fallback: the FIF channel, which is currently not
# Cornix-executed — that is the containment), 0 = shadow-only.
FIF2_LIVE_POSTING=1
# MAX1 (Bot 34, High-Conviction-Drossel über RUB2-SHORT, T-2026-CU-9050-067):
# 0 = Shadow-only, 1 = Live-Posting in CH_MAX1 (Default-Fallback: CH_MAIN).
# Der Flip ist ein Operator-Entscheid. Siehe docs/MODEL_INTENT.md §8a.
MAX1_LIVE_POSTING=0
# Drossel-Parameter: Mindest-Probability (nie unter dem Artefakt-Threshold 0,829)
# und harte rollierende 24h-Kappe. Vorschlag aus der 044-Kurve: 0,93 → ~1,3/Tag.
MAX1_MIN_PROB=0.93
MAX1_MAX_PER_DAY=3

# --- dashboard exposure + auth (P0.8 / P1.38-CSRF / audit item Z2) ---
# All three keys are OPTIONAL and every default is the hardened one, so an
# unconfigured deployment is the safe deployment. Supersedes the interim
# DASHBOARD_BIND_HOST knob from T-2026-KYT-9050-009 (same lever, now namespaced
# with the token and the allowlist). Effective at the next dashboard start.
#
# Bind address. Default 127.0.0.1 = loopback only. FAIL-CLOSED: binding
# anywhere else — or allowlisting an off-box hostname for a tunnel — WITHOUT
# KYTHERA_DASHBOARD_TOKEN makes dashboard.py refuse to start (exit 2). That is
# deliberate: the P0.8 state must not be reachable by setting one variable.
# KYTHERA_DASHBOARD_HOST=127.0.0.1
#
# Shared secret for the X-Dashboard-Token header / ?token= / cookie. A real
# secret belongs in .env only, never in code or docs (hard rule 3).
# KYTHERA_DASHBOARD_TOKEN=
#
# Extra Host-header values to accept, comma-separated — the tunnel's public
# hostname goes here. A non-empty list means "something off-box is expected to
# reach the dashboard" and therefore requires the token above.
# KYTHERA_DASHBOARD_ALLOWED_HOSTS=

